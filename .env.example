# Reference only. .env is ignored and NOT automatically loaded.
# Set variables in PowerShell; see README for a private signing-key command.
# SECRET_KEY must be a unique private random value of at least 32 characters.
# Never put an actual signing key or account password in this tracked file.
DATABASE_PATH=instance/honeyvault.sqlite3
# Explicit local HTTP override only. Omit or use production for HTTPS.
HONEYVAULT_ENV=development
